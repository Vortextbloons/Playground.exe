{
  "name": "playground-exe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "new:game": "tsx scripts/new-game.ts",
    "dev:game": "tsx scripts/dev-game.ts",
    "build:games": "tsx scripts/build-games.ts",
    "build": "npm run build:multiplayer && npm run build:games && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json && npm run check:party",
    "test": "tsx --test tests/*.test.ts",
    "build:multiplayer": "tsx scripts/build-multiplayer.ts",
    "dev:party": "npm run build:multiplayer && wrangler dev --port 8787",
    "types:party": "wrangler types workers/party/worker-configuration.d.ts --include-runtime false",
    "check:party": "npm run build:multiplayer && tsc --noEmit -p workers/party/tsconfig.json",
    "build:cloudflare": "tsx scripts/build-cloudflare.ts",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:party": "tsx tests/party.integration.ts"
  },
  "dependencies": {
    "@astrojs/svelte": "^9.1.0",
    "@playground-exe/game-kit": "file:packages/game-kit",
    "astro": "^7.4.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wrangler": "^4.151.1",
    "ws": "^8.22.0"
  }
}
