---
import Layout from '../../layouts/Layout.astro';
import GamePlayer from '../../components/GamePlayer.svelte';
import { discoverGames } from '../../data/games';
import type { GameMetadata } from '../../data/games';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() { return (await discoverGames()).map(game => ({ params: { id: game.id }, props: { game } })); }
interface Props { game: GameMetadata }
const { game } = Astro.props;
---
<Layout title={`${game.title} · Personal Arcade`}><article class="game-page"><a class="text-link" href={withBase()}>← Back to library</a><p class="eyebrow">{game.genre} / {game.version}</p><h1>{game.title}</h1><p class="intro-copy">By {game.author}</p><GamePlayer id={game.id} title={game.title} src={withBase(`games/${game.id}/index.html`)} client:load/><div class="game-info"><section><h2>About this game</h2><p>{game.description}</p><div class="tags">{game.tags.map(tag => <span>{tag}</span>)}</div></section><section><h2>How to play</h2><p>{game.controls}</p><p class="muted">Published {game.date} · Version {game.version}</p></section></div></article></Layout>
