---
import Layout from '../../layouts/Layout.astro';
import GamePlayer from '../../components/GamePlayer.svelte';
import GameMultiplayerNotice from '../../components/GameMultiplayerNotice.svelte';
import { discoverGames } from '../../data/games';
import type { GameMetadata } from '../../data/games';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() { return (await discoverGames()).map(game => ({ params: { id: game.id }, props: { game } })); }
interface Props { game: GameMetadata }
const { game } = Astro.props;
---
<Layout title={`${game.title} · Playground.exe`}><article class="game-page p-[40px_0_65px] [&>.eyebrow]:m-[34px_0_10px]"><a class="text-link [&:hover]:text-accent text-[12px] font-semibold inline-flex gap-[15px] items-center [background:none] border-0 p-[0]" href={withBase()}>← Back to library</a><p class="eyebrow font-sans text-[10px] font-semibold tracking-[1.8px] text-muted">{game.genre} / {game.version}</p><h1>{game.title}</h1><p class="intro-copy text-[14px] text-muted leading-[1.8] m-[22px_0] max-[760px]:text-[12px] max-[500px]:text-[13px]">By {game.author}</p><GameMultiplayerNotice gameId={game.id} config={game.multiplayer} solo={game.solo !== false} partyUrl={withBase('party/')} client:load /><GamePlayer id={game.id} title={game.title} src={withBase(`games/${game.id}/game.html`)} config={game.multiplayer} base={withBase()} client:load/><div class="game-info grid [grid-template-columns:1fr_1fr] gap-[50px] [border-top:1px_solid_var(--line)] pt-[28px] mt-[35px] [&_h2]:text-[21px] [&_h2]:mb-[15px] [&_p]:text-muted [&_p]:text-[14px] [&_p]:whitespace-pre-line max-[760px]:[grid-template-columns:1fr] max-[760px]:gap-[30px]"><section><h2>About this game</h2><p>{game.description}</p><div class="tags flex gap-[8px] mt-[18px] [&_span]:text-[11px] [&_span]:[background:#282131] [&_span]:text-[#cab3ee] [&_span]:p-[6px_9px] [&_span]:rounded-[5px]">{game.tags.map(tag => <span>{tag}</span>)}</div></section><section><h2>How to play</h2><p>{game.controls}</p><p class="muted text-muted mt-[20px]">Published {game.date} · Version {game.version}</p></section></div></article></Layout>
