---
import Layout from '../../layouts/Layout.astro';
import GamePlayer from '../../components/GamePlayer.svelte';
import GameMultiplayerNotice from '../../components/GameMultiplayerNotice.svelte';
import { discoverGames } from '../../data/games';
import type { GameMetadata } from '../../data/games';
import { withBase } from '../../lib/paths';
export async function getStaticPaths() { return (await discoverGames()).map(game => ({ params: { id: game.id }, props: { game } })); }
interface Props { game: GameMetadata }
const { game } = Astro.props;
---
<Layout playing title={`${game.title} · Playground.exe`}><article class="game-page"><div class="game-heading"><a class="text-link" href={withBase()}>&larr; Library</a><h1>{game.title}</h1><details class="game-help"><summary>Game info</summary><div class="help-panel"><GameMultiplayerNotice gameId={game.id} config={game.multiplayer} solo={game.solo !== false} partyUrl={withBase('party/')} client:load /><h2>How to play</h2><p>{game.controls}</p><h2>About this game</h2><p>{game.description}</p><p>By {game.author} / {game.genre} / Version {game.version}</p></div></details></div><div class="game-stage"><GamePlayer id={game.id} title={game.title} src={withBase(`games/${game.id}/game.html`)} config={game.multiplayer} base={withBase()} client:load/></div></article></Layout>

<style>
  .game-page { position:relative; height:100%; display:flex; flex-direction:column; gap:12px; padding:12px 0; }
  .game-heading { display:flex; align-items:center; gap:20px; flex-shrink:0; }
  .text-link, summary { font-size:12px; color:var(--accent); cursor:pointer; }
  h1 { flex:1; font-size:24px; letter-spacing:-.8px; }
  .game-help { margin-left:auto; }
  summary { min-height:44px; align-content:center; white-space:nowrap; }
  .help-panel { position:absolute; z-index:5; right:20px; top:116px; width:min(480px, calc(100vw - 40px)); max-height:calc(100dvh - 140px); overflow:auto; padding:20px; background:var(--surface); border:1px solid var(--line); border-radius:10px; box-shadow:0 12px 40px #0008; }
  .help-panel h2 { font-size:18px; margin-bottom:8px; }
  .help-panel p { font-size:13px; color:var(--muted); margin-bottom:16px; }
  .game-stage { flex:1; min-height:0; display:flex; flex-direction:column; }
  .game-stage :global(astro-island) { display:flex; flex-direction:column; flex:1; min-height:0; }
  @media(max-width:500px) { .game-heading { gap:12px; } h1 { font-size:18px; } }
  @media(max-height:500px) and (orientation:landscape) {
    .game-page { padding:0; gap:0; }
    .game-heading { position:absolute; z-index:20; top:max(6px,env(safe-area-inset-top)); left:max(8px,env(safe-area-inset-left)); gap:0; }
    .game-heading h1, .game-heading .game-help { display:none; }
    .game-heading .text-link { padding:5px 10px; font-size:11px; background:#111111d9; border:1px solid var(--line); border-radius:999px; }
  }
</style>
