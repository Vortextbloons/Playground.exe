---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
---
<Layout title="Not found · Playground.exe"><section class="empty-state min-h-[403px] [border:1px_dashed_#37313f] rounded-[12px] flex flex-col items-center justify-center text-center p-[35px_20px] [background:radial-gradient(ellipse_at_50%_30%,#bba4fa06,transparent_60%),#16151b] [&_h3]:text-[26px] [&_h3]:font-medium [&_h3]:tracking-[-.6px] [&_h3]:leading-[1.25] [&_p]:text-[12px] [&_p]:text-muted [&_p]:m-[14px_0_23px] [&_p]:leading-[1.8] min-[1400px]:min-h-[430px] max-[500px]:p-[32px_16px] max-[500px]:min-h-[405px] max-[500px]:[&_h3]:text-[24px] max-[500px]:[&_p]:text-[12px]"><p class="eyebrow font-sans text-[10px] font-semibold tracking-[1.8px] text-muted">404 / OUT OF BOUNDS</p><h1>This spot is empty.</h1><p>Head back to the library to find your next game.</p><a class="button primary inline-flex items-center justify-center gap-[24px] p-[12px_18px] rounded-[6px] text-[12px] font-semibold [border:1px_solid_transparent] bg-accent text-[#21182f] [&:hover]:[background:#cbb7ff]" href={withBase()}>Back to library</a></section></Layout>
