---
import Layout from '../layouts/Layout.astro';
import Library from '../components/Library.svelte';
import { discoverGames } from '../data/games';
import { withBase } from '../lib/paths';
const games = await discoverGames();
---
<Layout><section class="intro grid [grid-template-columns:1.3fr_1fr] items-center p-[40px_0_48px] gap-[36px] [&_.text-link]:mt-[2px] max-[760px]:gap-[0] max-[760px]:[grid-template-columns:1fr_.65fr] max-[760px]:p-[32px_0] max-[500px]:[grid-template-columns:1fr] max-[500px]:p-[28px_0_24px]"><div><h1>Small games.<br/><span>Endless possibilities.</span></h1><a class="text-link [&:hover]:text-accent text-[12px] font-semibold inline-flex gap-[15px] items-center [background:none] border-0 p-[0]" href="#library">Explore the library <span aria-hidden="true">↓</span></a></div><div class="hero-art h-[290px] relative grid place-items-center isolate max-[760px]:[transform:scale(.72)] max-[760px]:[transform-origin:center] max-[760px]:w-[210px] max-[760px]:ml-[-10px] max-[500px]:hidden" aria-hidden="true"><div class="orbit orbit-one absolute w-[320px] h-[195px] [border:1px_solid_#2c2936] rounded-[50%] [transform:rotate(-25deg)] z-[-1] max-[760px]:w-[240px]"></div><div class="orbit orbit-two absolute w-[330px] h-[185px] [border:1px_solid_#2c2936] rounded-[50%] [transform:rotate(32deg)] z-[-1] max-[760px]:w-[250px]"></div><span class="spark spark-one absolute text-accent text-[31px] top-[25px] right-[45px] max-[760px]:right-[0]">✦</span><span class="spark spark-two absolute text-mint text-[22px] bottom-[58px] left-[33px] max-[760px]:left-[-8px]">+</span><div class="cartridge w-[188px] h-[224px] [border:1px_solid_#746889] [background:linear-gradient(135deg,#4b405e,#2b2638)] rounded-[15px_15px_22px_15px] [transform:rotate(11deg)] [box-shadow:10px_12px_0_#1e1b27,11px_13px_0_#41394f] p-[15px]"><div class="cartridge-top flex justify-between [font:7px_monospace] tracking-[1px] text-[#c5b5da]"><span>PLAYGROUND.EXE</span><span>✦</span></div><div class="cartridge-screen h-[139px] [background:#b7a1d1] mt-[15px] rounded-[5px] [box-shadow:inset_0_0_0_5px_#8e7aab] flex flex-col items-center justify-center gap-[16px] text-[#3c304f] [background-image:repeating-linear-gradient(0deg,transparent,transparent_2px,#45335d09_2px,#45335d09_3px)] [&>span:last-child]:[font:6px_monospace] [&>span:last-child]:tracking-[1px]"><span class="pixel-face [font:54px_monospace] leading-[1]">·ᴗ·</span><span>INSERT YOUR NEXT IDEA</span></div><div class="cartridge-bottom flex items-center gap-[4px] mt-[17px] [&_i]:w-[5px] [&_i]:h-[14px] [&_i]:[background:#211d2c] [&_i]:rounded-[1px] [&>span]:[font:8px_monospace] [&>span]:text-[#b6a8c9] [&>span]:ml-auto"><i></i><i></i><i></i><span>PG—001</span></div></div><span class="art-caption [font:8px_monospace] tracking-[2px] text-[#736b81] absolute bottom-[0] max-[760px]:whitespace-nowrap">GOOD THINGS START WITH PLAY.</span></div></section>
<Library {games} base={withBase()} guide={withBase('guide/')} client:load />
</Layout>
