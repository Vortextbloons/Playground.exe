---
import Layout from '../layouts/Layout.astro';
import Library from '../components/Library.svelte';
import { discoverGames } from '../data/games';
import { withBase } from '../lib/paths';
const games = await discoverGames();
---
<Layout><section class="intro"><div><p class="eyebrow"><span class="status-dot"></span> YOUR OWN CORNER OF THE INTERNET</p><h1>Small games.<br/><span>Endless possibilities.</span></h1><p class="intro-copy">A home for experiments, side quests, and just-one-more-try.<br class="desktop-break"/> Pick something up. See where it takes you.</p><a class="text-link" href="#library">Explore the library <span aria-hidden="true">↓</span></a></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="spark spark-one">✦</span><span class="spark spark-two">+</span><div class="cartridge"><div class="cartridge-top"><span>PERSONAL ARCADE</span><span>✦</span></div><div class="cartridge-screen"><span class="pixel-face">·ᴗ·</span><span>INSERT YOUR NEXT IDEA</span></div><div class="cartridge-bottom"><i></i><i></i><i></i><span>PA—001</span></div></div><span class="art-caption">GOOD THINGS START WITH PLAY.</span></div></section>
<Library {games} base={withBase()} guide={withBase('guide/')} client:load />
</Layout>
