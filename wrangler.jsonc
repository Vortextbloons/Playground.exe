{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playground-exe",
  "main": "workers/party/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "PARTIES", "class_name": "PartyRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }],
  "ratelimits": [{ "name": "PARTY_REQUESTS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321,https://vortextbloons.github.io" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
